{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PewhProgrammer/changelogs/blob/main/schema/entry.schema.json",
  "title": "Changelog entry",
  "description": "One released version. File must be named <version>.json and live in entries/.",
  "type": "object",
  "required": ["version", "date", "title"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Version identifier, must match the filename"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Release date, YYYY-MM-DD, used as the sort key"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "One line headline for the release"
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "description": "Repository the release shipped from"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Short paragraph shown under the title"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["new", "improved", "fixed"] },
      "description": "Badges rendered on the entry, fixed semantic set"
    },
    "image": {
      "type": "string",
      "pattern": "^assets/",
      "description": "Screenshot path relative to entries/, e.g. assets/0.2.0-shot.png"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "items"],
        "additionalProperties": false,
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "description": "Headed bullet lists, e.g. New / Improved / Fixed"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" }
        }
      },
      "description": "Related links, e.g. commits or PRs"
    }
  }
}
